CONFIG_IDF_TARGET="esp32c5"
# Bootloader and early console stay at 115200 on UART0 until the app sets
# UART_BAUD (main/app_main.c) for the data lines; quiet logs keep that short.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# The radio timestamp is only precise without power saving.
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_PM_ENABLE=n
# Keep the receive path in IRAM.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# The boot line carries this many hex chars of the ELF sha256 (flash.py checks it).
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16
# 2.1.0 streams on the native USB-Serial-JTAG port when a host is attached; keep
# the USB console enabled (the IDF default) so its driver pieces are built in.
# Logs stay silenced in app_main, so nothing else writes there.
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
