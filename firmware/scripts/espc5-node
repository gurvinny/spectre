#!/bin/sh
# Keep one stable device node per ESP32-C5 native USB port, named by the chip
# MAC the port reports as its USB serial number: /dev/espc5/D0CF13XXXXXX.
#
# The port can come back as a new device (after a flash, a cable pulled, a
# power loss). A container that
# binds this directory (docker-compose.usb.yml) sees each node come back under
# the same name; a container given a single device sees it go stale.
#
# Called by udev (99-espc5.rules):
#   espc5-node add <serial> <major> <minor>
#   espc5-node remove <serial>
# ESPC5_DIR, ESPC5_MODE and ESPC5_GROUP override the defaults below.
#
# Author: gurvinny
# Project: SPECTRE
set -eu

dir=${ESPC5_DIR:-/dev/espc5}
mode=${ESPC5_MODE:-0660}
group=${ESPC5_GROUP:-dialout}

[ $# -ge 2 ] || { echo "usage: espc5-node add|remove <serial> [<major> <minor>]" >&2; exit 2; }
# Only hex digits survive: the serial becomes a path component.
name=$(printf '%s' "$2" | tr -cd '0-9A-Fa-f' | tr 'a-f' 'A-F')
[ ${#name} -eq 12 ] || { echo "espc5-node: '$2' is not a MAC" >&2; exit 2; }
node=$dir/$name

case $1 in
add)
    [ $# -eq 4 ] || { echo "espc5-node: add needs <major> <minor>" >&2; exit 2; }
    mkdir -p "$dir"
    rm -f "$node"
    mknod -m "$mode" "$node" c "$3" "$4"
    chgrp "$group" "$node" 2>/dev/null || true
    ;;
remove)
    rm -f "$node"
    ;;
*)
    echo "espc5-node: unknown action '$1'" >&2
    exit 2
    ;;
esac
