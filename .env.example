# ┌────────────────────────────────────────────────────────────────────┐
# │  SPECTRE — WiFi Threat Sensor · environment configuration           │
# │  Copy to .env (init.sh does this for you) and adjust per host.       │
# │  Never commit the real .env — it is gitignored.                     │
# └────────────────────────────────────────────────────────────────────┘

# ── Secret ────────────────────────────────────────────────────────────
# 64 hex chars, generated by init.sh via `openssl rand`. Reserved: nothing
# reads it yet. Sessions are random server-side tokens, and config values
# (including Wazuh settings) are stored unencrypted in the SQLite database.
SPECTRE_SECRET=

# ── Host / networking ─────────────────────────────────────────────────
# LAN IP the web UI is reached on (this dev server = 10.0.0.10).
HOST_IP=10.0.0.10

# Public ports (chosen to avoid the dashboard project's 4000/3001/9001).
WEB_PORT=4100
API_PORT=8100

# Where the browser reaches the API (used by the Next.js frontend).
NEXT_PUBLIC_API_BASE=http://10.0.0.10:8100
# Build-time: true adds the experimental 3D battlespace to the console.
NEXT_PUBLIC_EXPERIMENTAL=false

# Browser origin(s) allowed to call the API with the session cookie, comma
# separated. Leave unset to use http://HOST_IP:WEB_PORT. Never "*".
# SPECTRE_WEB_ORIGINS=http://10.0.0.10:4100

# ── Serial / sensor boards ────────────────────────────────────────────
# Comma-separated list of serial devices for the ESP32-C5 boards.
# Band is auto-detected from each board's boot event, so order here does
# not matter. On this dev server: 2.4GHz=ttyUSB0, 5GHz=ttyUSB1.
SERIAL_PORTS=/dev/ttyUSB0,/dev/ttyUSB1
# Must match the firmware: 921600 for the v2 firmware in firmware/ (2.0.5 on; 460800
# for 2.0.4 and earlier), 115200 for the original sniffer firmware. Any unsupported
# value stops the sensor at startup.
SERIAL_BAUD=921600

# Ingest source: "serial" (real boards) or "sim" (built-in simulator).
SPECTRE_SOURCE=serial
# Board commands from the console (retune, reset, reboot). Off unless "true":
# a command interrupts capture. Needs the v2 firmware; every command is
# recorded in board_events. Read on every start, not seeded.
SPECTRE_BOARD_CONTROL=false

# ── Storage / retention ───────────────────────────────────────────────
SPECTRE_DB=/data/spectre.db
# Rolling raw-frame retention (hours). Aggregates & threats kept long-term.
RAW_RETENTION_HOURS=48
# Disk guard: prune early if the data partition exceeds this percent used.
DISK_GUARD_PERCENT=85

# ── Wazuh / syslog forwarding ─────────────────────────────────────────
# Point these at your own SIEM host; the defaults are examples only.
# These can also be edited at runtime from Settings → stored in SQLite.
WAZUH_ENABLED=true
WAZUH_HOST=10.0.0.20
WAZUH_PORT=514
WAZUH_PROTO=udp          # udp | tcp
WAZUH_APP_NAME=spectre
# Seconds between rolling summary events forwarded to Wazuh.
SUMMARY_INTERVAL_SECONDS=60
